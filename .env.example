# Copy this file to .env and adjust values as needed.
# Paths can be relative to the project root or absolute.

# Input/output paths
SEQUENCES_FILE=data/reads/SRR31234567_1.fastq
REFERENCE_FASTA=data/reference/reference.fasta
RESULT_FILE=output/levenshtein_best_matches.csv
LOG_FILE=output/sequencing.log

# Processing controls
SEQUENCE_FORMAT=fastq
RUN_ALL_RECORDS=false
MAX_READS=10000
SAMPLE_READ_POOL=10000
SAMPLE_READ_COUNT=100
RANDOM_SEED=42
LEVENSHTEIN_PROCESSES=4

# Logging controls
LOG_LEVEL=INFO
READ_PROGRESS_INTERVAL=25
LEVENSHTEIN_RESULT_LOG_EVERY=10

# Scoring tolerances
BEST_SCORE_EPSILON=1e-15
TIE_SCORE_ABS_TOL=1e-12
